# Names only. Load catalog/auth values through vault run, never commit values.
# Production/shared PostgreSQL only. Local development overrides this with embedded PostgreSQL.
DATABASE_URL=
# Platform-managed MovieFinder credential (production); existing local key remains supported.
MOVIEFINDER_AUTH_SECRET=
BETTER_AUTH_SECRET=
TMDB_API_READ_ACCESS_TOKEN=
# Plain app-specific configuration; do not reuse another app's BETTER_AUTH_URL.
MOVIEFINDER_ORIGIN=
# Optional comma-separated exact HTTPS origins; register a callback for each.
MOVIEFINDER_ADDITIONAL_ORIGINS=
PORT=
# Set by the infrastructure allocation workflow, only after ownership is approved.
MOVIEFINDER_DATABASE_ALLOCATION=
# Google is the only sign-in method. Public relay settings from an approved registration (no Google secret).
# Register exactly <MOVIEFINDER_ORIGIN>/api/auth/callback/auth-relay.
MOVIEFINDER_OIDC_ISSUER=
MOVIEFINDER_OIDC_CLIENT_ID=
