{
  "name": "moviefinder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vault run -- bun scripts/dev.ts",
    "dev:local": "bun scripts/dev.ts",
    "start": "bun src/server/index.ts",
    "telemetry": "bun scripts/telemetry.ts",
    "perf": "bun scripts/perf.ts",
    "build": "vp build",
    "check": "vp check && vp test run --project unit",
    "test": "vp test run --project unit",
    "test:integration": "bun scripts/verify.ts integration",
    "test:e2e": "bun scripts/verify.ts e2e",
    "format": "vp fmt",
    "lint": "vp lint",
    "db:validate": "atlas migrate validate --dir file://atlas/migrations",
    "db:check": "bun scripts/local-database-command.ts check",
    "db:diff": "bun scripts/migrate.ts diff",
    "db:migrate": "bun scripts/local-database-command.ts apply",
    "db:status": "bun scripts/local-database-command.ts status",
    "db:drift": "bun scripts/local-database-command.ts drift",
    "db:verify": "bun scripts/schema-diff.ts verify --check",
    "db:check:shared": "vault run -- bun scripts/database-check.ts",
    "db:migrate:shared": "vault run -- bun scripts/migrate.ts apply",
    "db:status:shared": "vault run -- bun scripts/migrate.ts status",
    "test:local-database": "vp test run --project local-database",
    "db:drift:shared": "vault run -- bun scripts/migrate.ts drift",
    "test:observability": "bun scripts/verify.ts observability"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@mantine/core": "9.7.3",
    "@mantine/dates": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@mantine/notifications": "9.7.3",
    "@tanstack/query-db-collection": "1.4.5",
    "@tanstack/react-db": "0.5.10",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-router": "1.170.44",
    "better-auth": "1.7.10",
    "dayjs": "1.11.23",
    "drizzle-orm": "0.45.4",
    "fractional-indexing": "4.0.0",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "lucide-react": "1.57.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swiper": "14.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@crvouga/mockingbird-service-oauth": "3.11.0",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "embedded-postgres": "18.4.0-beta.17",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vite-plus": "1.2.0"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@embedded-postgres/darwin-arm64",
    "@embedded-postgres/darwin-x64",
    "@embedded-postgres/linux-arm",
    "@embedded-postgres/linux-arm64",
    "@embedded-postgres/linux-ia32",
    "@embedded-postgres/linux-ppc64",
    "@embedded-postgres/linux-x64",
    "@embedded-postgres/windows-x64"
  ]
}
